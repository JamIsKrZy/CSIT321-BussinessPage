@page "/our-works"

<PageTitle>JusRight Hydro — Our Works</PageTitle>

<section class="bg-cream pt-20 pb-24">
    <div class="container">
        <p class="eyebrow">Greenhouse Portfolios &amp; Collaborations</p>
        <h1 class="mt-2.5 mb-6 text-[2.4rem] leading-[1.15] lg:text-[3.4rem]">Hydroponic methods, <span class="text-leaf not-italic">realized harvests</span></h1>
        <p class="mb-14 max-w-[62ch] text-[1.05rem] leading-[1.65] text-ink-muted">
            Take a look inside our specialized growing installations. We supply world-class
            restaurateurs, commercial kitchens, and community markets with precise botanical
            consistency.
        </p>

        <div class="grid gap-9 lg:grid-cols-2">
            @foreach (var work in works)
            {
                <div class="overflow-hidden rounded-card border border-line bg-white shadow-[0_4px_16px_rgba(0,0,0,0.03)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(0,0,0,0.05)]">
                    <img class="h-[315px] w-full object-cover" src="@work.ImageUrl" alt="@work.ImageAlt" />
                    <div class="p-9">
                        <div class="mb-2.5 flex items-center justify-between gap-4">
                            <h3 class="text-[1.75rem]">@work.Title</h3>
                            <span class="text-[0.72rem] font-bold tracking-[0.06em] whitespace-nowrap text-fern uppercase">@work.Badge</span>
                        </div>
                        <p class="mb-3.5 text-[1.02rem] font-semibold text-ink">@work.Subtitle</p>
                        <p class="text-[0.96rem] leading-relaxed">@work.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="bg-white py-24">
    <div class="container">
        <p class="eyebrow text-center">Closed-Loop Hydroscience</p>
        <h2 class="mx-auto mt-2 mb-15 text-center text-[2.5rem]">How we grow without compromise</h2>

        <div class="grid gap-12 lg:grid-cols-2 min-[1151px]:grid-cols-4">
            @foreach (var step in steps)
            {
                <div>
                    <div class="mb-4 font-serif text-[2.8rem] leading-none text-clay">@step.Number</div>
                    <h4 class="mb-3 font-sans text-[1.15rem] font-bold">@step.Title</h4>
                    <p class="text-[0.95rem] leading-relaxed">@step.Description</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="bg-sage py-20">
    <div class="container grid gap-8 lg:grid-cols-3">
        <div>
            <p class="eyebrow">Annual Greens Output</p>
            <div class="mt-1.5 font-serif text-[3.4rem] leading-[1.1] text-forest">45,000+ lbs</div>
        </div>
        <div>
            <p class="eyebrow">Active Chef Partners</p>
            <div class="mt-1.5 font-serif text-[3.4rem] leading-[1.1] text-forest">28 Venues</div>
        </div>
        <div>
            <p class="eyebrow">Pesticides Used</p>
            <div class="mt-1.5 font-serif text-[3.4rem] leading-[1.1] text-forest">0.00%</div>
        </div>
    </div>
</section>

@code {
    private record WorkItem(string ImageUrl, string ImageAlt, string Title, string Badge, string Subtitle, string Description);
    private record ProcessStep(string Number, string Title, string Description);

    private readonly List<WorkItem> works = new()
    {
        new(
            "images/dome-delta.jpg",
            "Interior of the Dome Delta-4 glass dome greenhouse",
            "Dome Delta-4",
            "Premium Retail Yield",
            "Advanced Automated Glass Dome",
            "Our largest climate chamber. Outfitted with LED dynamic spectra mimics and vertical water-recycling towers to grow our award-winning Butterhead lettuce."
        ),
        new(
            "images/urban-loop.jpg",
            "Interior of the Urban Loop-6 container farm",
            "Urban Loop-6",
            "Local Chef Partnerships",
            "Hyper-Local Container Farm",
            "A repurposed modular container system designed specifically for dense culinary herbs, supplying city restaurants with ultra-fragrant Genovese basil."
        ),
    };

    private readonly List<ProcessStep> steps = new()
    {
        new("01", "Purified Water Feed", "All water goes through reverse-osmosis filtration before receiving custom, plant-specific organic mineral profiles."),
        new("02", "Root Submersion & Mist", "Roots suspend cleanly in oxygen-enriched reservoirs. Continuous sensor monitors detect micro-nutrient ratios."),
        new("03", "Led Solar Mimicry", "Bespoke color-spectrum lights track the natural solar cycle, yielding robust leaves and optimal nutrient synthesis."),
        new("04", "Living Cut Harvest", "Greens are pulled gently with their subterranean roots completely intact, safeguarding freshness until final consumption."),
    };
}
