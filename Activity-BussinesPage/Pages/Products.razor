@page "/products"
@inject Supabase.Client Db
@using static Supabase.Postgrest.Constants

<div class="products-page">
    <div class="products-header">
        <h1 class="page-title">Products</h1>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-banner mb-4">
            <strong>Error:</strong> @errorMessage
        </div>
    }

    <div class="flex gap-2 mb-4">
        <input @bind="newName"
               placeholder="Product name"
               class="rounded border px-3 py-2" />
        <input @bind="newPrice" type="number"
               class="w-28 rounded border px-3 py-2" />
        <button @onclick="Add"
                disabled="@saving"
                class="rounded bg-red-800 px-4 py-2
                       text-white disabled:opacity-50">
            @if (saving)
            {
                <span>Saving...</span>
            }
            else
            {
                <span>Add</span>
            }
        </button>
    </div>

    <ul class="space-y-2">
        @foreach (var p in items)
        {
            <li class="flex gap-3 rounded border p-3">
                <span class="flex-1">@p.Name · @p.Price</span>
                <button @onclick="() => Raise(p)">+10</button>
                <button @onclick="() => Remove(p)">Delete</button>
            </li>
        }
    </ul>
</div>

@code {
    List<Product> items = new();
    string newName = "";
    decimal newPrice;
    bool saving;
    string? errorMessage;

    protected override async Task OnInitializedAsync()
        => await Load();

    async Task Load()
    {
        try
        {
            errorMessage = null;
            var res = await Db.From<Product>()
                .Where(p => p.DeletedAt == null) // habit 2
                .Order(p => p.Id, Ordering.Ascending)
                .Range(0, 49) // first 50
                .Get(); // sends GET
            items = res.Models;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task Add() // sends POST
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        saving = true;
        errorMessage = null;
        try
        {
            await Db.From<Product>().Insert(new Product
            {
                Name = newName,
                Price = newPrice
            });
            newName = "";
            newPrice = 0;
            await Load();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    async Task Raise(Product p) // sends PATCH
    {
        errorMessage = null;
        try
        {
            await Db.From<Product>()
                .Where(x => x.Id == p.Id)
                .Set(x => x.Price, p.Price + 10)
                .Update();
            await Load();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task Remove(Product p) // soft delete
    {
        errorMessage = null;
        try
        {
            await Db.From<Product>()
                .Where(x => x.Id == p.Id)
                .Set(x => x.DeletedAt!, DateTime.UtcNow)
                .Update();
            await Load();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
