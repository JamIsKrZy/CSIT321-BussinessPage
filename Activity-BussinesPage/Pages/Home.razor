@page "/"

<PageTitle>JusRight Hydro — Home</PageTitle>

<section class="bg-cream pt-18 pb-22">
    <div class="container grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div>
            <p class="eyebrow">100% Soil-Free, Hyper-Local Cultivation</p>
            <h1 class="mt-2.5 mb-5.5 text-[2.4rem] leading-[1.15] tracking-[-0.01em] lg:text-[3.4rem]">Greens grown with <span class="italic text-leaf">absolute integrity</span></h1>
            <p class="mb-9 max-w-[48ch] text-[1.05rem] leading-relaxed text-ink-muted">
                At JusRight, we nurture crisp, flavor-locked greens inside climate-optimized,
                closed-loop hydroponic systems. Delivering pure, chemical-free harvests from
                greenhouse to table within hours.
            </p>
            <div class="flex flex-wrap gap-4">
                <a class="btn btn-primary" href="/shop">Explore Live Crops</a>
                <a class="btn btn-outline" href="/our-works">Our Growing System</a>
            </div>
        </div>

        <div class="flex flex-col gap-4">
            <img class="h-[380px] w-full rounded-card object-cover" src="images/hero-greenhouse.jpg" alt="Rows of hydroponic greens inside a sunlit greenhouse" />
            <div class="grid grid-cols-2 gap-4">
                <img class="h-[140px] w-full rounded-tile object-cover" src="images/hero-thumb-1.jpg" alt="Close up of a hydroponic green" />
                <img class="h-[140px] w-full rounded-tile object-cover" src="images/hero-thumb-2.jpg" alt="Hand adjusting a hydroponic tray" />
            </div>
        </div>
    </div>
</section>

<section class="bg-white py-20">
    <div class="container grid gap-14 lg:grid-cols-3">
        <div>
            <div class="mb-6 flex size-12 items-center justify-center rounded-full bg-sage text-fern">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
            </div>
            <h3 class="mb-3 text-[1.35rem]">Zero Synthetic Chemicals</h3>
            <p class="text-[0.95rem] leading-relaxed">Our closed greenhouse shields plants naturally. We rely on beneficial insects and biological security, promising 100% clean leaves straight from the stem.</p>
        </div>
        <div>
            <div class="mb-6 flex size-12 items-center justify-center rounded-full bg-sage text-fern">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31L4.14 20.3a2 2 0 0 0 1.72 2.7h12.28a2 2 0 0 0 1.72-2.7L14 9.31V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
            </div>
            <h3 class="mb-3 text-[1.35rem]">95% Less Water Saved</h3>
            <p class="text-[0.95rem] leading-relaxed">By continuously recycling our nutrient-rich water through advanced closed loops, we grow premium, hydration-optimized produce with minimal environmental strain.</p>
        </div>
        <div>
            <div class="mb-6 flex size-12 items-center justify-center rounded-full bg-sage text-fern">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            </div>
            <h3 class="mb-3 text-[1.35rem]">Flavor-Locked Peak Nutrition</h3>
            <p class="text-[0.95rem] leading-relaxed">Harvested at their culinary zenith and delivered with living roots intact, preserving the crunchy textures, vibrant colors, and natural essential oils.</p>
        </div>
    </div>
</section>

<section class="bg-cream py-22">
    <div class="container">
        <div class="mb-11 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="eyebrow">Weekly Harvest Menu</p>
                <h2 class="text-[2.2rem]">Freshly cut greens delivered live</h2>
            </div>
            <a class="btn btn-outline" href="/shop">View All 18 Varieties</a>
        </div>

        <div class="grid gap-8 lg:grid-cols-3">
            @foreach (var item in menuItems)
            {
                <div class="overflow-hidden rounded-card border border-line bg-white transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(0,0,0,0.04)]">
                    <img class="h-[260px] w-full object-cover" src="@item.ImageUrl" alt="@item.ImageAlt" />
                    <div class="px-5.5 pt-5 pb-6">
                        <div class="mb-3 flex items-center justify-between">
                            <span class="rounded-full bg-sage px-3 py-1.25 text-xs font-bold tracking-wide text-fern uppercase">@item.Tag</span>
                            <span class="text-[1.05rem] font-bold text-forest">@item.Price</span>
                        </div>
                        <h4 class="font-sans text-[1.15rem] font-semibold">@item.Name</h4>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="bg-sage py-22">
    <div class="container grid items-center gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-18">
        <img class="h-[480px] w-full rounded-card object-cover" src="images/origin.jpg" alt="Grower tending to hydroponic greens" />
        <div>
            <p class="eyebrow">Our Origin &amp; Ethics</p>
            <h2 class="mt-1 mb-5.5 text-[2.35rem] leading-[1.2]">Rethinking the journey from sprout to palate</h2>
            <p class="mb-8 max-w-[52ch] leading-[1.65]">
                Traditional farming drives crop degradation through endless shipping lines.
                JusRight was founded in the heart of our community to dismantle the supply chain.
                By managing our growing chambers with scientific rigor, we deliver superior greens
                without soil exhaustion, weather dependency, or heavy transport footprint.
            </p>
            <div class="flex gap-14">
                <div>
                    <div class="font-serif text-[2.3rem] leading-none text-forest">4 Hours</div>
                    <div class="mt-1.5 text-sm text-ink-muted">Sprout-to-Table Window</div>
                </div>
                <div>
                    <div class="font-serif text-[2.3rem] leading-none text-forest">100%</div>
                    <div class="mt-1.5 text-sm text-ink-muted">Traceable Heritage Seeds</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-cream py-22">
    <div class="container">
        <h2 class="mb-13 text-center text-[2.3rem]">Our Growing Metrics</h2>
        <div class="grid gap-8 lg:grid-cols-3">
            <div class="rounded-card border border-line bg-white px-9 py-10">
                <div class="mb-3.5 font-serif text-[3.4rem] leading-none text-leaf">95%</div>
                <h4 class="mb-2.5 font-sans text-[1.15rem] font-bold">Water Reduction</h4>
                <p class="text-[0.95rem] leading-relaxed">Our bespoke mist and recapture system prevents standard evaporation and ground leaching loss.</p>
            </div>
            <div class="rounded-card border border-line bg-white px-9 py-10">
                <div class="mb-3.5 font-serif text-[3.4rem] leading-none text-clay">365</div>
                <h4 class="mb-2.5 font-sans text-[1.15rem] font-bold">Days of Perfect Grow</h4>
                <p class="text-[0.95rem] leading-relaxed">Completely insulated from seasonal frosts, heatwaves, and droughts for consistent year-round supply.</p>
            </div>
            <div class="rounded-card border border-line bg-white px-9 py-10">
                <div class="mb-3.5 font-serif text-[3.4rem] leading-none text-forest">0%</div>
                <h4 class="mb-2.5 font-sans text-[1.15rem] font-bold">Soil Contamination</h4>
                <p class="text-[0.95rem] leading-relaxed">Eliminating risky heavy metals, microplastics, and pathogenic hazards naturally residing in commercial soil fields.</p>
            </div>
        </div>
    </div>
</section>

<section class="bg-white py-26">
    <div class="mx-auto max-w-[780px] px-6 text-center">
        <div class="mb-6 flex justify-center">
            <svg width="30" height="20" viewBox="0 0 30 20" fill="none">
                <line x1="2" y1="3" x2="28" y2="3" stroke="#c17a52" stroke-width="2" stroke-linecap="round"/>
                <line x1="6" y1="10" x2="24" y2="10" stroke="#c17a52" stroke-width="2" stroke-linecap="round"/>
                <line x1="10" y1="17" x2="20" y2="17" stroke="#c17a52" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </div>
        <p class="mb-9 font-serif text-[1.85rem] leading-[1.45] font-normal text-forest">
            As a chef, texture is paramount. The butterhead lettuce from JusRight retains its
            crisp bite days longer than any conventional crop. It has completely transformed our
            salad course.
        </p>
        <div class="flex items-center justify-center gap-4">
            <img class="size-12 rounded-full object-cover" src="images/chef-elena.jpg" alt="Portrait of Chef Elena Rostova" />
            <div class="text-left">
                <div class="text-[0.95rem] font-bold text-ink">Chef Elena Rostova</div>
                <div class="text-[0.85rem] text-ink-muted">Executive Culinary Director, L'Herbarium</div>
            </div>
        </div>
    </div>
</section>

<section class="bg-[linear-gradient(rgba(22,40,26,0.82),rgba(22,40,26,0.88)),url('/images/cta-bg.jpg')] bg-cover bg-center bg-no-repeat py-24">
    <div class="mx-auto max-w-[680px] px-6 text-center">
        <h2 class="mb-4 text-[2.35rem] text-white">Taste the hydroponic difference today</h2>
        <p class="mb-9 text-[1.05rem] leading-relaxed text-[#d8e0ce]">
            Get fresh, nutrient-dense living greens harvested to order and delivered straight to
            your neighborhood collection point.
        </p>
        <a class="btn bg-leaf px-9 py-[0.95rem] text-[0.98rem] text-white hover:bg-fern" href="/shop">Secure Your Harvest Box →</a>
    </div>
</section>

@code {
    private record MenuItem(string ImageUrl, string ImageAlt, string Tag, string Price, string Name);

    private readonly List<MenuItem> menuItems = new()
    {
        new("images/product-butterhead.jpg", "Living butterhead lettuce", "Best Seller", "$4.50", "Living Butterhead Bouquet"),
        new("images/product-kale.jpg", "Bunch of Tuscan dino kale", "Iron Rich", "$4.25", "Living Tuscan Dino Kale"),
        new("images/product-basil.jpg", "Potted Genovese basil", "Aromatic", "$3.75", "Potted Genovese Sweet Basil"),
    };
}
