@page "/"

<PageTitle>JusRight Hydro — Home</PageTitle>

<section class="hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">100% Soil-Free, Hyper-Local Cultivation</p>
            <h1 class="hero-title">Greens grown with <span class="accent">absolute integrity</span></h1>
            <p class="hero-desc">
                At JusRight, we nurture crisp, flavor-locked greens inside climate-optimized,
                closed-loop hydroponic systems. Delivering pure, chemical-free harvests from
                greenhouse to table within hours.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="/shop">Explore Live Crops</a>
                <a class="btn btn-outline" href="/our-works">Our Growing System</a>
            </div>
        </div>

        <div class="hero-media">
            <img class="hero-main-img" src="images/hero-greenhouse.jpg" alt="Rows of hydroponic greens inside a sunlit greenhouse" />
            <div class="hero-thumbs">
                <img src="images/hero-thumb-1.jpg" alt="Close up of a hydroponic green" />
                <img src="images/hero-thumb-2.jpg" alt="Hand adjusting a hydroponic tray" />
            </div>
        </div>
    </div>
</section>

<section class="features">
    <div class="container features-grid">
        <div class="feature">
            <div class="feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
            </div>
            <h3>Zero Synthetic Chemicals</h3>
            <p>Our closed greenhouse shields plants naturally. We rely on beneficial insects and biological security, promising 100% clean leaves straight from the stem.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31L4.14 20.3a2 2 0 0 0 1.72 2.7h12.28a2 2 0 0 0 1.72-2.7L14 9.31V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
            </div>
            <h3>95% Less Water Saved</h3>
            <p>By continuously recycling our nutrient-rich water through advanced closed loops, we grow premium, hydration-optimized produce with minimal environmental strain.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            </div>
            <h3>Flavor-Locked Peak Nutrition</h3>
            <p>Harvested at their culinary zenith and delivered with living roots intact, preserving the crunchy textures, vibrant colors, and natural essential oils.</p>
        </div>
    </div>
</section>

<section class="menu">
    <div class="container">
        <div class="menu-header">
            <div>
                <p class="eyebrow">Weekly Harvest Menu</p>
                <h2>Freshly cut greens delivered live</h2>
            </div>
            <a class="btn btn-outline" href="/shop">View All 18 Varieties</a>
        </div>

        <div class="menu-grid">
            @foreach (var item in menuItems)
            {
                <div class="menu-card">
                    <img src="@item.ImageUrl" alt="@item.ImageAlt" />
                    <div class="menu-card-body">
                        <div class="menu-card-top">
                            <span class="tag">@item.Tag</span>
                            <span class="price">@item.Price</span>
                        </div>
                        <h4>@item.Name</h4>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="origin">
    <div class="container origin-grid">
        <img class="origin-img" src="images/origin.jpg" alt="Grower tending to hydroponic greens" />
        <div class="origin-copy">
            <p class="eyebrow">Our Origin &amp; Ethics</p>
            <h2>Rethinking the journey from sprout to palate</h2>
            <p>
                Traditional farming drives crop degradation through endless shipping lines.
                JusRight was founded in the heart of our community to dismantle the supply chain.
                By managing our growing chambers with scientific rigor, we deliver superior greens
                without soil exhaustion, weather dependency, or heavy transport footprint.
            </p>
            <div class="origin-stats">
                <div>
                    <div class="stat-num">4 Hours</div>
                    <div class="stat-label">Sprout-to-Table Window</div>
                </div>
                <div>
                    <div class="stat-num">100%</div>
                    <div class="stat-label">Traceable Heritage Seeds</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="metrics">
    <div class="container">
        <h2 class="metrics-title center">Our Growing Metrics</h2>
        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-num green">95%</div>
                <h4>Water Reduction</h4>
                <p>Our bespoke mist and recapture system prevents standard evaporation and ground leaching loss.</p>
            </div>
            <div class="metric-card">
                <div class="metric-num terracotta">365</div>
                <h4>Days of Perfect Grow</h4>
                <p>Completely insulated from seasonal frosts, heatwaves, and droughts for consistent year-round supply.</p>
            </div>
            <div class="metric-card">
                <div class="metric-num">0%</div>
                <h4>Soil Contamination</h4>
                <p>Eliminating risky heavy metals, microplastics, and pathogenic hazards naturally residing in commercial soil fields.</p>
            </div>
        </div>
    </div>
</section>

<section class="testimonial">
    <div class="container testimonial-inner">
        <div class="quote-mark">
            <svg width="30" height="20" viewBox="0 0 30 20" fill="none">
                <line x1="2" y1="3" x2="28" y2="3" stroke="#c17a52" stroke-width="2" stroke-linecap="round"/>
                <line x1="6" y1="10" x2="24" y2="10" stroke="#c17a52" stroke-width="2" stroke-linecap="round"/>
                <line x1="10" y1="17" x2="20" y2="17" stroke="#c17a52" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </div>
        <p class="quote-text">
            As a chef, texture is paramount. The butterhead lettuce from JusRight retains its
            crisp bite days longer than any conventional crop. It has completely transformed our
            salad course.
        </p>
        <div class="quote-author">
            <img src="images/chef-elena.jpg" alt="Portrait of Chef Elena Rostova" />
            <div>
                <div class="author-name">Chef Elena Rostova</div>
                <div class="author-role">Executive Culinary Director, L'Herbarium</div>
            </div>
        </div>
    </div>
</section>

<section class="cta">
    <div class="container cta-inner">
        <h2>Taste the hydroponic difference today</h2>
        <p class="cta-desc">
            Get fresh, nutrient-dense living greens harvested to order and delivered straight to
            your neighborhood collection point.
        </p>
        <a class="btn btn-cta" href="/shop">Secure Your Harvest Box →</a>
    </div>
</section>

@code {
    private record MenuItem(string ImageUrl, string ImageAlt, string Tag, string Price, string Name);

    private readonly List<MenuItem> menuItems = new()
    {
        new("images/product-butterhead.jpg", "Living butterhead lettuce", "Best Seller", "$4.50", "Living Butterhead Bouquet"),
        new("images/product-kale.jpg", "Bunch of Tuscan dino kale", "Iron Rich", "$4.25", "Living Tuscan Dino Kale"),
        new("images/product-basil.jpg", "Potted Genovese basil", "Aromatic", "$3.75", "Potted Genovese Sweet Basil"),
    };
}
